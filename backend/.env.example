APP_NAME=StudyMate API
DEBUG=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODEL=

# ------------------------------------------------------------------------------------------
# Optional settings. Every line below is commented out and shows the current default, so it
# changes nothing. To change one, remove the "# " in front of it, edit the value, and restart
# the backend. See the README (Quick start, Hardening) for what each optional one does.
# ------------------------------------------------------------------------------------------

# --- AI service ---
#   Retries for rate limits and short errors; the delay doubles each attempt.
# LLM_MAX_RETRIES=3
# LLM_RETRY_BASE_DELAY=1.0
#   Give up on one AI request after this many seconds.
# LLM_TIMEOUT_SECONDS=60

# --- Retrieval ---
#   Below this similarity a question counts as not in your documents.
# MIN_SIMILARITY=0.55
#   Most passages an answer is built from (8 since Phase 9).
# RETRIEVAL_TOP_K=8
#   Passages that are mostly symbols (text diagrams) are left out below this share.
# MIN_ALNUM_RATIO=0.5
#   Leave out tables of contents and lists of figures. Off: measured with no gain.
# EXCLUDE_FRONT_MATTER=false
#   Earlier messages a follow-up question can see.
# HISTORY_WINDOW=6
#   The local embedding model. Changing it means re-uploading every document.
# EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# --- Study tools ---
#   Most AI calls one summary, quiz or flashcard request may make.
# STUDY_MAX_LLM_CALLS=8
#   Characters of document text in one summary call.
# STUDY_BATCH_CHARS=12000
#   Passages a quiz or flashcard set is made from.
# STUDY_MAX_PASSAGES=10
#   A summary starts no new AI call after this many seconds and returns a partial summary.
# STUDY_MAX_SECONDS=180

# --- Uploads and maintenance ---
#   Largest PDF accepted, in MB.
# MAX_UPLOAD_MB=50
#   Folder for your documents, the search index and the database (relative to backend).
#   Changing it makes the app start with an empty library.
# DATA_DIR=data
#   At startup, delete leftovers of interrupted uploads. Off until you choose to turn it on.
# STARTUP_CLEANUP=false
